{
  "version": 2,
  "buildCommand": "pip install -r requirements.txt",
  "outputDirectory": "public",
  "functions": {
    "api/index.py": {
      "includeFiles": "public/data/**"
    }
  },
  "routes": [
    { "src": "/api/(.*)", "dest": "/api/index.py" },
    { "src": "/data/(.*)", "dest": "/data/$1" },
    { "src": "/(.*)", "dest": "/$1" }
  ]
}
