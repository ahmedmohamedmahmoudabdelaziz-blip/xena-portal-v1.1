{
  "buildCommand": "python fetch_data.py",
  "outputDirectory": "public",
  "crons": [
    {
      "path": "/api/cron/build-snapshot",
      "schedule": "0,30 * * * *"
    }
  ],
  "functions": {
    "api/**/*.py": {
      "maxDuration": 60,
      "includeFiles": "public/data/**"
    }
  },
  "routes": [
    { "src": "/api/(.*)", "dest": "/api/index.py" },
    { "src": "/data/(.*)", "dest": "/data/$1" },
    { "src": "/(.*)", "dest": "/$1" }
  ]
}
