{
  "buildCommand": "pip install -r requirements.txt && python fetch_data.py",
  "outputDirectory": "public",
  "builds": [
    { "src": "public/**", "use": "@vercel/static" },
    { "src": "api/index.py", "use": "@vercel/python" }
  ],
  "routes": [
    { "src": "/api/(.*)", "dest": "/api/index.py" },
    { "src": "/data/(.*)", "dest": "/data/$1" },
    { "src": "/(.*)", "dest": "/$1" }
  ]
}
